{
  "request": {
    "method": "GET",
    "urlPath": "/charges",
    "queryParameters": {
      "reference": {
        "matches": ".+"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "id": "pay_{{randomValue length=12 type='ALPHANUMERIC'}}",
      "reference": "{{request.query.reference}}",
      "status": "succeeded"
    },
    "transformers": [
      "response-template"
    ]
  }
}