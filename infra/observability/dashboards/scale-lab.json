{
 "uid": "scale-lab",
 "title": "Scale Lab",
 "tags": [
  "scale-lab"
 ],
 "timezone": "browser",
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "schemaVersion": 39,
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "RED: Rate, Errors, Duration (the user's view)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Rate: requests per second",
   "description": "How many requests arrive. Compare with the k6 target RPS.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 5
     },
     "color": {
      "mode": "shades",
      "fixedColor": "text"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ],
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (uri, method) (rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[30s]))",
     "legendFormat": "{{method}} {{uri}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "interval": "5s"
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Errors: 5xx and 4xx per second",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 5
     },
     "color": {
      "mode": "shades",
      "fixedColor": "text"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ],
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (uri, status) (rate(http_server_requests_seconds_count{uri!~\"/actuator.*\", status=~\"[45]..\"}[30s]))",
     "legendFormat": "{{status}} {{uri}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "interval": "5s"
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Duration: p50 / p95 / p99 (all endpoints)",
   "description": "Why the average lies: watch it stay low while p99 explodes.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 5
     },
     "color": {
      "mode": "shades",
      "fixedColor": "text"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ],
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[30s])))",
     "legendFormat": "p50",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[30s])))",
     "legendFormat": "p95",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[30s])))",
     "legendFormat": "p99",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "D",
     "expr": "sum(rate(http_server_requests_seconds_sum{uri!~\"/actuator.*\"}[30s])) / sum(rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[30s]))",
     "legendFormat": "average (lies)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "interval": "5s"
  },
