  {
   "id": 7,
   "type": "timeseries",
   "title": "DB connection pool (HikariCP)",
   "description": "pending > 0 means requests queue for the database. Little's Law lives here.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 5
     },
     "color": {
      "mode": "shades",
      "fixedColor": "text"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ],
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(hikaricp_connections_active)",
     "legendFormat": "active (in use)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "sum(hikaricp_connections_idle)",
     "legendFormat": "idle",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "C",
     "expr": "sum(hikaricp_connections_pending)",
     "legendFormat": "pending (threads WAITING for a connection)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "D",
     "expr": "max(hikaricp_connections_max)",
     "legendFormat": "max",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "interval": "5s"
  },
