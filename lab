#!/usr/bin/env bash
# lab: one command for everything in the scale lab.
# Run `./lab help` to see the commands.
set -euo pipefail
cd "$(dirname "$0")"

# The project targets Java 25. macOS /usr/bin/java may point at an older JDK, so prefer SDKMAN's.
if [ -z "${JAVA_HOME:-}" ] && [ -d "$HOME/.sdkman/candidates/java/current" ]; then
  export JAVA_HOME="$HOME/.sdkman/candidates/java/current"
fi

APP_URL="http://localhost:4180"
PAY_ADMIN="http://localhost:4189/__admin"
K6_IMAGE="grafana/k6:latest"

c_bold=$'\033[1m'; c_dim=$'\033[2m'; c_red=$'\033[31m'; c_grn=$'\033[32m'; c_off=$'\033[0m'

say()  { printf '%s\n' "$*"; }
die()  { printf '%s%s%s\n' "$c_red" "$*" "$c_off" >&2; exit 1; }

psql_lab() { docker compose exec -T postgres psql -U lab -d lab "$@"; }

app_up() { curl -sf "$APP_URL/actuator/health" >/dev/null 2>&1; }

cmd_help() {
  cat <<EOF
${c_bold}Scale Lab${c_off}

  Daily loop
    ./lab today                 show today's mission
    ./lab status                progress table
    ./lab done <NN> "<note>"    mark mission NN done with a one-line takeaway

  Infrastructure
    ./lab up [profile...]       start Postgres, Grafana stack, fake payment provider
                                profiles unlock later: cache, events, scale, chaos
    ./lab down                  stop everything (data is kept)
    ./lab reset                 stop everything AND delete the database volume
    ./lab seed                  fill the database (2k dealers, 20k products, 400k orders)
    ./lab run                   start the Spring Boot app on :4180
    ./lab test                  run the JUnit tests

  Measure
    ./lab load <scenario> [RPS] run a k6 load test, save results/…json
                                scenarios: $(ls load | grep -v lib.js | sed 's/\.js//' | tr '\n' ' ')
    ./lab race                  100 dealers buy the last 10 items at the same moment
    ./lab compare <scenario>    compare the last two runs of a scenario
    ./lab sql "<query>"         run SQL against the lab database
    ./lab explain "<query>"     EXPLAIN (ANALYZE, BUFFERS) a query
    ./lab topsql                slowest queries from pg_stat_statements

  Break things
    ./lab chaos payment <normal|slow|very-slow|hang|errors|down>

  URLs
    App         $APP_URL
    Grafana     http://localhost:4182   (dashboard: Scale Lab)
    Prometheus  http://localhost:4183
EOF
}

cmd_up() {
  local profiles=()
  for p in "$@"; do profiles+=(--profile "$p"); done
  docker compose ${profiles[@]+"${profiles[@]}"} up -d --wait
  psql_lab -qc "CREATE EXTENSION IF NOT EXISTS pg_stat_statements" >/dev/null 2>&1 || true
  say "${c_grn}infra is up.${c_off} Grafana: http://localhost:4182"
}

cmd_down()  { docker compose --profile '*' down; }
cmd_reset() { docker compose --profile '*' down -v; say "database volume deleted. Run ./lab up, ./lab run, ./lab seed."; }

cmd_seed() {
  app_up || die "start the app first (./lab run) so Flyway creates the tables."
  say "seeding... (30-90 s)"
  time psql_lab -q -v ON_ERROR_STOP=1 -f /seed.sql
  psql_lab -c "SELECT (SELECT count(*) FROM dealers) dealers, (SELECT count(*) FROM products) products,
                      (SELECT count(*) FROM orders) orders, (SELECT count(*) FROM order_items) items"
}

cmd_run() {
  [ -f .lab-env ] && set -a && . ./.lab-env && set +a
  ./mvnw -q spring-boot:run
}

cmd_test() { ./mvnw -q test; }

cmd_sql()     { psql_lab -c "$1"; }
cmd_explain() { psql_lab -c "EXPLAIN (ANALYZE, BUFFERS) $1"; }
cmd_topsql() {
  psql_lab -c "SELECT calls, round(mean_exec_time::numeric,2) AS mean_ms, round(total_exec_time::numeric) AS total_ms,
                      left(regexp_replace(query, '\s+', ' ', 'g'), 110) AS query
               FROM pg_stat_statements WHERE query NOT ILIKE '%pg_stat%'
               ORDER BY total_exec_time DESC LIMIT 15"
}

cmd_load() {
  local scenario="${1:-}"; local rps="${2:-}"
  [ -n "$scenario" ] || die "usage: ./lab load <scenario> [RPS]"
  [ -f "load/$scenario.js" ] || die "no such scenario: load/$scenario.js"
  app_up || die "app is not running on :4180 (./lab run)"
  mkdir -p results
  local stamp; stamp="$(date +%Y-%m-%d_%H%M%S)"
  local out="results/${stamp}_${scenario}${rps:+_${rps}rps}.json"
  say "${c_bold}load: $scenario${rps:+ at $rps rps}${c_off}  ${c_dim}(watch Grafana: http://localhost:4182)${c_off}"
  set +e
  docker run --rm -i --add-host host.docker.internal:host-gateway \
    -v "$PWD/load:/scripts:ro" -v "$PWD/results:/results" \
    -e BASE_URL=http://host.docker.internal:4180 ${rps:+-e RPS=$rps} \
    -e K6_PROMETHEUS_RW_SERVER_URL=http://host.docker.internal:4183/api/v1/write \
    -e K6_PROMETHEUS_RW_TREND_STATS="p(50),p(95),p(99),max" \
    "$K6_IMAGE" run --quiet -o experimental-prometheus-rw --tag testid="$stamp" \
    --summary-export "/$out" "/scripts/$scenario.js"
  local code=$?
  set -e
  say ""
  summarize "$out"
  [ $code -eq 0 ] && say "${c_grn}thresholds passed${c_off}" || say "${c_red}thresholds FAILED (exit $code)${c_off}"
  say "${c_dim}saved: $out${c_off}"
}

summarize() {
  python3 - "$1" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))["metrics"]
dur = d.get("http_req_duration", {})
reqs = d.get("http_reqs", {})
failed = d.get("http_req_failed", {})
print(f"  requests  {reqs.get('count', 0):>8}   ({reqs.get('rate', 0):.1f}/s)")
print(f"  failed    {failed.get('value', 0) * 100:>7.2f}%")
for k in ("med", "p(90)", "p(95)", "max"):
    if k in dur:
        print(f"  {k:<8}  {dur[k]:>8.1f} ms")
for name in ("orders_accepted", "orders_rejected", "dropped_iterations"):
    if name in d:
        print(f"  {name:<18} {d[name].get('count', 0)}")
PY
}

cmd_compare() {
  local scenario="${1:-}"
  [ -n "$scenario" ] || die "usage: ./lab compare <scenario>"
  local files; files=$(ls -1 results/*_"$scenario"*.json 2>/dev/null | tail -2)
  [ "$(echo "$files" | wc -l | tr -d ' ')" = "2" ] || die "need at least two runs of $scenario"
  python3 - $files <<'PY'
import json, sys
a, b = [json.load(open(f))["metrics"] for f in sys.argv[1:3]]
def g(m, metric, key): return m.get(metric, {}).get(key, 0)
rows = [("rps", "http_reqs", "rate", 1), ("failed %", "http_req_failed", "value", 100),
        ("p50 ms", "http_req_duration", "med", 1), ("p95 ms", "http_req_duration", "p(95)", 1),
        ("max ms", "http_req_duration", "max", 1)]
print(f"{'':10}{'before':>12}{'after':>12}{'change':>10}")
for label, metric, key, mul in rows:
    x, y = g(a, metric, key) * mul, g(b, metric, key) * mul
    ch = f"{(y - x) / x * 100:+.0f}%" if x else "-"
    print(f"{label:10}{x:>12.1f}{y:>12.1f}{ch:>10}")
print("\nbefore:", sys.argv[1]); print("after: ", sys.argv[2])
PY
}

cmd_race() {
  app_up || die "app is not running (./lab run)"
  psql_lab -qc "UPDATE products SET stock = 10 WHERE id = 20000"
  local before; before=$(psql_lab -tAc "SELECT count(*) FROM order_items WHERE product_id = 20000")
  cmd_load last-item
  local after stock; after=$(psql_lab -tAc "SELECT count(*) FROM order_items WHERE product_id = 20000")
  stock=$(psql_lab -tAc "SELECT stock FROM products WHERE id = 20000")
  say ""
  say "${c_bold}race result${c_off}: stock was 10"
  say "  orders written for the product : $((after - before))   (correct: 10)"
  say "  final stock                    : $stock   (correct: 0)"
  if [ "$((after - before))" = "10" ] && [ "$stock" = "0" ]; then say "${c_grn}correct${c_off}"; else say "${c_red}WRONG: the system sold stock it did not have, or lost updates${c_off}"; fi
}

cmd_chaos() {
  local target="${1:-}" mode="${2:-}"
  [ "$target" = "payment" ] || die "usage: ./lab chaos payment <normal|slow|very-slow|hang|errors|down>"
  curl -sf -X POST "$PAY_ADMIN/mappings/reset" >/dev/null
  curl -sf -X POST "$PAY_ADMIN/settings" -H 'Content-Type: application/json' -d '{"fixedDelay":0}' >/dev/null
  case "$mode" in
    normal)    ;;
    slow)      curl -sf -X POST "$PAY_ADMIN/settings" -H 'Content-Type: application/json' -d '{"fixedDelay":2000}' >/dev/null ;;
    very-slow) curl -sf -X POST "$PAY_ADMIN/settings" -H 'Content-Type: application/json' -d '{"fixedDelay":9000}' >/dev/null ;;
    hang)      curl -sf -X POST "$PAY_ADMIN/settings" -H 'Content-Type: application/json' -d '{"fixedDelay":120000}' >/dev/null ;;
    errors)    curl -sf -X POST "$PAY_ADMIN/mappings" -H 'Content-Type: application/json' \
                 -d '{"priority":1,"request":{"method":"POST","url":"/charges"},"response":{"status":503,"body":"provider overloaded"}}' >/dev/null ;;
    down)      curl -sf -X POST "$PAY_ADMIN/mappings" -H 'Content-Type: application/json' \
                 -d '{"priority":1,"request":{"method":"POST","url":"/charges"},"response":{"fault":"CONNECTION_RESET_BY_PEER"}}' >/dev/null ;;
    *) die "unknown mode: $mode" ;;
  esac
  say "payment provider: ${c_bold}$mode${c_off}"
}

# ---------- progress ----------

cmd_status() { sed -n '/^| #/,/^$/p' PROGRESS.md; }

cmd_today() {
  local nn
  nn=$(awk -F'|' '/^\| [0-9][0-9] /{ gsub(/ /,"",$2); gsub(/ /,"",$5); if ($5 != "done") { print $2; exit } }' PROGRESS.md)
  [ -n "$nn" ] || { say "all written missions are done. Ask Hermes: 'scale lab: write the next mission'"; return; }
  local f; f=$(ls labs/"$nn"-*.md 2>/dev/null | head -1 || true)
  if [ -z "$f" ]; then
    say "mission $nn is on the roadmap but not written yet."
    say "Ask Hermes: 'scale lab: write mission $nn'"
    return
  fi
  if command -v glow >/dev/null; then glow "$f"; else cat "$f"; fi
}

cmd_done() {
  local nn="${1:-}" note="${2:-}"
  [[ "$nn" =~ ^[0-9][0-9]$ ]] || die "usage: ./lab done <NN> \"what I learned in one line\""
  [ -n "$note" ] || die "write one line about what you learned. That line is the point."
  python3 - "$nn" "$note" "$(date +%Y-%m-%d)" <<'PY'
import re, sys
nn, note, day = sys.argv[1:]
lines = open("PROGRESS.md").read().split("\n")
for i, l in enumerate(lines):
    if l.startswith(f"| {nn} "):
        cells = [c.strip() for c in l.strip("|").split("|")]
        cells[3] = "done"; cells[4] = day
        lines[i] = "| " + " | ".join(cells) + " |"
        break
else:
    sys.exit(f"mission {nn} not in PROGRESS.md")
text = "\n".join(lines).rstrip("\n") + f"\n- {day} [{nn}] {note}\n"
open("PROGRESS.md", "w").write(text)
PY
  say "${c_grn}mission $nn done.${c_off} Commit: git add -A && git commit -m \"feat: complete lab $nn\""
}

case "${1:-help}" in
  help|-h|--help) cmd_help ;;
  up)       shift; cmd_up "$@" ;;
  down)     cmd_down ;;
  reset)    cmd_reset ;;
  seed)     cmd_seed ;;
  run)      cmd_run ;;
  test)     cmd_test ;;
  sql)      shift; cmd_sql "$*" ;;
  explain)  shift; cmd_explain "$*" ;;
  topsql)   cmd_topsql ;;
  load)     shift; cmd_load "$@" ;;
  compare)  shift; cmd_compare "$@" ;;
  race)     cmd_race ;;
  chaos)    shift; cmd_chaos "$@" ;;
  status)   cmd_status ;;
  today)    cmd_today ;;
  done)     shift; cmd_done "$@" ;;
  *) die "unknown command: $1 (./lab help)" ;;
esac
